{
  "name": "chinaslop-tracker-tools",
  "description": "Project metadata and root scripts for formatting, testing, and dependency management.",
  "private": true,
  "scripts": {
    "format": "prettier --write . --config .config/prettier/.prettierrc.json --ignore-path .gitignore --ignore-path .config/prettier/.prettierignore",
    "format:check": "prettier --check . --config .config/prettier/.prettierrc.json --ignore-path .gitignore --ignore-path .config/prettier/.prettierignore",
    "format:rust": "cargo fmt --manifest-path windows/Cargo.toml",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
